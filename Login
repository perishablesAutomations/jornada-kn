<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ingreso · KN Jornadas</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Syne:wght@600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --navy:   #003087;
      --blue:   #0099DA;
      --green:  #08C792;
      --white:  #ffffff;
      --off:    #f4f7fb;
      --border: rgba(0,48,135,0.12);
      --muted:  #6b7a99;
      --text:   #0d1b38;
      --error:  #dc2626;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--off);
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 20px;
    }

    .card {
      background: var(--white);
      border-radius: 16px;
      box-shadow: 0 4px 32px rgba(0,48,135,0.10);
      width: 100%;
      max-width: 400px;
      overflow: hidden;
    }

    /* Header con barra de acento */
    .card-header {
      background: var(--navy);
      padding: 28px 32px 24px;
      position: relative;
    }
    .card-header::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--blue), var(--green));
    }
    .logo-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
    }
    .logo-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--green);
      flex-shrink: 0;
    }
    .logo-text {
      font-family: 'Syne', sans-serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
    }
    .card-title {
      font-family: 'Syne', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--white);
      line-height: 1.2;
    }
    .card-subtitle {
      font-size: 13px;
      color: rgba(255,255,255,0.55);
      margin-top: 4px;
    }

    /* Formulario */
    .card-body {
      padding: 28px 32px 32px;
    }

    .field {
      margin-bottom: 18px;
    }
    label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.7px;
      color: var(--navy);
      margin-bottom: 6px;
    }
    input {
      width: 100%;
      padding: 10px 14px;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      color: var(--text);
      background: var(--off);
      outline: none;
      transition: border-color 0.15s, background 0.15s;
    }
    input:focus {
      border-color: var(--blue);
      background: var(--white);
      box-shadow: 0 0 0 3px rgba(0,153,218,0.12);
    }
    input::placeholder { color: #b0bac8; }

    .btn {
      width: 100%;
      padding: 12px;
      background: var(--navy);
      color: var(--white);
      border: none;
      border-radius: 8px;
      font-family: 'Syne', sans-serif;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s;
      margin-top: 8px;
      letter-spacing: 0.3px;
    }
    .btn:hover:not(:disabled) { background: #002166; }
    .btn:active:not(:disabled) { transform: scale(0.99); }
    .btn:disabled { opacity: 0.55; cursor: default; }

    /* Error */
    .error-box {
      display: none;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 13px;
      color: var(--error);
      margin-bottom: 16px;
    }
    .error-box.show { display: block; }

    /* Loading spinner */
    .spinner {
      display: inline-block;
      width: 16px; height: 16px;
      border: 2.5px solid rgba(255,255,255,0.3);
      border-top-color: white;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      vertical-align: middle;
      margin-right: 6px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Footer */
    .card-footer {
      padding: 0 32px 20px;
      font-size: 11px;
      color: var(--muted);
      text-align: center;
    }
  </style>
</head>
<body>

<div class="card">
  <div class="card-header">
    <div class="logo-row">
      <span class="logo-dot"></span>
      <span class="logo-text">KN · Jornadas</span>
    </div>
    <div class="card-title">Bienvenido</div>
    <div class="card-subtitle">Air Logistics Perishables · Bogotá</div>
  </div>

  <div class="card-body">
    <div class="error-box" id="errorBox"></div>

    <div class="field">
      <label for="username">Usuario</label>
      <input type="text" id="username" placeholder="tu.usuario" autocomplete="username" />
    </div>

    <div class="field">
      <label for="password">Contraseña</label>
      <input type="password" id="password" placeholder="••••••••" autocomplete="current-password" />
    </div>

    <button class="btn" id="btnLogin">Ingresar</button>
  </div>

  <div class="card-footer">
    Acceso restringido al equipo KN Perishables
  </div>
</div>

<script>
// ── CONFIG ──────────────────────────────────────────────────────────────────
const FLOW_LOGIN = 'https://bd4a763d737defaeacf0e99a4d082f.58.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/27/workflows/aefaa172a6f5448bb4ee41ff7266acc0/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=YQas8-PtNRiA60nFWxitLmlsPxosGw93OpenmIfHNqA';

// ── LÓGICA DE REDIRECCIÓN POR ROL ───────────────────────────────────────────
function redirigirPorRol(cargo, email, adminToken) {
  const base = window.location.origin + window.location.pathname.replace('login.html', '');
  if (cargo === 'Admin') {
    window.location.href = `${base}resumen.html?email=${encodeURIComponent(email)}&adminToken=${adminToken}`;
  } else if (cargo === 'Manager') {
    window.location.href = `${base}aprobaciones.html?email=${encodeURIComponent(email)}`;
  } else {
    // Empleado
    window.location.href = `${base}resumen.html?email=${encodeURIComponent(email)}`;
  }
}

// ── SI YA HAY SESIÓN ACTIVA, REDIRIGIR ─────────────────────────────────────
(function checkSession() {
  const sesion = sessionStorage.getItem('kn_sesion');
  if (sesion) {
    try {
      const { cargo, email, adminToken } = JSON.parse(sesion);
      redirigirPorRol(cargo, email, adminToken);
    } catch { sessionStorage.removeItem('kn_sesion'); }
  }
})();

// ── LOGIN ───────────────────────────────────────────────────────────────────
const ADMIN_TOKEN = 'kn-perish-2026-adm-X7mQ9p';

async function login() {
  const username = document.getElementById('username').value.trim();
  const password = document.getElementById('password').value;
  const errorBox = document.getElementById('errorBox');
  const btn      = document.getElementById('btnLogin');

  errorBox.classList.remove('show');

  if (!username || !password) {
    errorBox.textContent = 'Ingresa tu usuario y contraseña.';
    errorBox.classList.add('show');
    return;
  }

  btn.disabled = true;
  btn.innerHTML = '<span class="spinner"></span> Verificando...';

  try {
    const res = await fetch(FLOW_LOGIN, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password })
    });

    if (res.status === 401) {
      errorBox.textContent = 'Usuario o contraseña incorrectos.';
      errorBox.classList.add('show');
      return;
    }

    const data = await res.json();

    if (!data.success) {
      errorBox.textContent = data.mensaje || 'Error al iniciar sesión.';
      errorBox.classList.add('show');
      return;
    }

    // Guardar sesión en sessionStorage — nunca en la URL
    const sesion = {
      token:      data.token,
      email:      data.email,
      nombre:     data.nombre,
      cargo:      data.cargo,
      adminToken: data.cargo === 'Admin' ? ADMIN_TOKEN : null
    };
    sessionStorage.setItem('kn_sesion', JSON.stringify(sesion));

    redirigirPorRol(data.cargo, data.email, sesion.adminToken);

  } catch (e) {
    errorBox.textContent = 'Error de conexión. Intenta de nuevo.';
    errorBox.classList.add('show');
  } finally {
    btn.disabled = false;
    btn.innerHTML = 'Ingresar';
  }
}

// Enter para submit
document.getElementById('password').addEventListener('keydown', e => {
  if (e.key === 'Enter') login();
});
document.getElementById('username').addEventListener('keydown', e => {
  if (e.key === 'Enter') document.getElementById('password').focus();
});
document.getElementById('btnLogin').addEventListener('click', login);
</script>
</body>
</html>
